# =====================================================
# 开发环境变量（npm run dev 时自动加载）
# =====================================================

# API 基础地址：开发环境下走 Vite 代理（见 vite.config.js），保持与后端同源
VITE_API_BASE_URL=/api

# 后端服务地址：Vite dev server 会把 /api 开头的请求代理到该地址
VITE_BACKEND_URL=http://localhost:8000
